CONFIG_LOW_LEVEL_OPTIONS=y
# CONFIG_MACH_LPC176X is not set
# CONFIG_MACH_STM32 is not set
CONFIG_MACH_GD32=y
# CONFIG_MACH_RPXXXX is not set
CONFIG_BOARD_DIRECTORY="gd32"
CONFIG_MCU="gd32f303xc"
CONFIG_CLOCK_FREQ=120000000
CONFIG_FLASH_SIZE=0x40000
CONFIG_FLASH_BOOT_ADDRESS=0x08000000
CONFIG_RAM_START=0x20000000
CONFIG_RAM_SIZE=0xc000
CONFIG_STACK_SIZE=512
CONFIG_FLASH_APPLICATION_ADDRESS=0x08002000
CONFIG_FLASH_START=0x08000000
CONFIG_LAUNCH_APP_ADDRESS=0x08002000
CONFIG_BLOCK_SIZE=64
CONFIG_GD32_SELECT=y
# CONFIG_MACH_GD32F303XB is not set
CONFIG_MACH_GD32F303XC=y
# CONFIG_MACH_GD32F303XE is not set
# CONFIG_MACH_GD32E230X6 is not set
# CONFIG_MACH_GD32E230X8 is not set
CONFIG_MACH_GD32F303XX=y
CONFIG_MACH_GD32F30X=y
# CONFIG_GD32_FLASH_START_0000 is not set
CONFIG_GD32_FLASH_START_2000=y
# CONFIG_GD32_SERIAL_USART1_PA2_PA3 is not set
# CONFIG_GD32_USB_PA11_PA12 is not set
# CONFIG_GD32_CANBUS_PA11_PA12 is not set
CONFIG_GD32_CANBUS_PB8_PB9=y
# CONFIG_GD32_CANBUS_PD0_PD1 is not set
CONFIG_HAVE_CHIPID=y
CONFIG_GD32_APP_START_2000=y
CONFIG_USB_VENDOR_ID=0x1d50
CONFIG_USB_DEVICE_ID=0x6177
CONFIG_USB_SERIAL_NUMBER="12345"
CONFIG_CANSERIAL=y
CONFIG_CANBUS=y
CONFIG_CANBUS_FREQUENCY=1000000
CONFIG_CANBUS_FILTER=y
CONFIG_HAVE_OPTIMIZE_OS=y
# CONFIG_HAVE_OPTIMIZE_O2 is not set
# CONFIG_HAVE_OPTIMIZE_OZ is not set
# CONFIG_HAVE_OPTIMIZE_OG is not set
# CONFIG_HAVE_OPTIMIZE_O0 is not set
CONFIG_OPTIMIZE_FLAG="-Os"
CONFIG_INITIAL_PINS=""
CONFIG_ENABLE_DOUBLE_RESET=y
# CONFIG_ENABLE_BUTTON is not set
# CONFIG_ENABLE_LED is not set
CONFIG_BUILD_DEPLOYER=y
CONFIG_KATAPULT_VERSION=""
